{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Repertoire": "Data Source=repertoire.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrationsOnStartup": false,
    "LogSql": false,
    "Postgres": {
      "MaxPoolSize": 20,
      "MinPoolSize": 2,
      "TimeoutSeconds": 5
    }
  },
  "Cors": {
    "FrontendOrigin": "http://localhost:5173"
  }
}
